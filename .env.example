# Crivo (AIR Lab) — modelo de configuração local.
#
# Copie para `.env` (que NÃO vai para o repositório) e preencha.
# No perfil local nada disto é obrigatório: a aplicação sobe o PostgreSQL embarcado
# e gera uma chave de desenvolvimento em ./data/dev-identity.key.
# No perfil prod todas as variáveis abaixo são obrigatórias e a aplicação não inicia sem elas.

# Banco de dados do sistema (perfil prod)
AIRLAB_DB_URL=jdbc:postgresql://127.0.0.1:5432/airlab
AIRLAB_DB_USER=airlab_app
AIRLAB_DB_PASSWORD=

# Chave AES-256 em Base64 para os campos do esquema identity e para a custódia da semente.
# Gere com:  openssl rand -base64 32
AIRLAB_IDENTITY_KEY=

# Credencial do pesquisador. Gere o hash bcrypt fora do repositório e guarde só o hash.
AIRLAB_RESEARCHER_USER=pesquisador
AIRLAB_RESEARCHER_PASSWORD_HASH=

# Protocolo P4 (SPEC E13): sem SMTP e sem contato humano, a inscricao de contas fica fechada
# no perfil prod. No perfil local nada sai da maquina: os e-mails ficam numa caixa de saida.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
AIRLAB_MAIL_FROM=
AIRLAB_CONTACT_EMAIL=
# Opcional: recebe por e-mail os avisos de etapa concluida (eles sempre aparecem no painel).
AIRLAB_ADMIN_EMAIL=
# Referencia da aprovacao do comite de etica (CEP/Plataforma Brasil). Sem ela, em producao,
# o formulario de pedido de consulta do P4 fica fechado (SPEC E10, trava 4).
AIRLAB_CEP_REFERENCE=

# Rede: a aplicação escuta em loopback e o Caddy faz o HTTPS na borda.
AIRLAB_BIND=127.0.0.1
AIRLAB_PORT=8080

# Armazenamento de mídia (fora do repositório, em disco criptografado)
AIRLAB_STORAGE_PATH=./data/media
